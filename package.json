{
  "name": "parla-benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "size": "node size.js",
    "types": "node types.js",
    "memory": "node memory.js",
    "perf": "vitest bench --run --reporter=default --reporter=json --outputFile.json=.tmp/bench.json && node summary.js",
    "test": "vitest run",
    "bench": "node results.js",
    "parla:update": "pnpm --dir ../parla pack:all && rm -rf .packs && cp -R ../parla/.packs .packs && git -C ../parla describe --always --dirty > .packs/commit && pnpm install",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.2",
    "@lingui/cli": "6.12.0",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@marcalexiei/oxfmt-config": "2.0.1",
    "@marcalexiei/oxlint-config": "1.9.0",
    "@parlajs/compiler": "0.0.0",
    "@parlajs/core": "0.0.0",
    "@parlajs/react": "0.0.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "i18next": "27.2.4",
    "i18next-icu": "2.7.1",
    "intl-messageformat": "12.2.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "react-intl": "12.2.0",
    "typesafe-i18n": "5.27.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
